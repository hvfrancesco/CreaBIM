{
  "$schema": "../docs/creabim-model.schema.json",
  "version": 1,
  "units": "m",
  "display_units": { "length": "mm" },

  "materials": [
    { "id": "render", "library": "Render, lime" },
    { "id": "block", "library": "Block, concrete" },
    { "id": "aircrete", "library": "Block, aerated concrete" },
    { "id": "plaster", "library": "Plaster, gypsum" },
