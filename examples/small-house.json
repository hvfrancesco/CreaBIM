        { "function": "finish", "material": "render", "thickness": 0.02 },
        { "function": "structure", "material": "block", "thickness": 0.215 },
        { "function": "finish", "material": "plaster", "thickness": 0.015 }
      ]
    }
  ],

  "types": [
